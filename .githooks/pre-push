#!/usr/bin/env bash
#
# Deploy gate pre-push hook.
# Runs the verify script before allowing pushes to remote.
# To bypass intentionally (rare): git push --no-verify
#

set -uo pipefail

echo "==> Running deploy gate pre-push hook (verify)..."
if [ -d "sim" ]; then
  cd sim
  npm ci
  if ! npm run verify; then
    echo ""
    echo "🚫 PUSH BLOCKED — verify script failed."
    echo "Fix the errors and try again, or use --no-verify to bypass."
    echo ""
    exit 1
  fi
fi

exit 0
